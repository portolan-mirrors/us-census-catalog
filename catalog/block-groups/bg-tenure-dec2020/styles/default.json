{
  "version": 8,
  "name": "Owner-occupied housing",
  "metadata": {
    "description": "Share of occupied housing units that are owner-occupied (H4), pale pink to deep magenta -- a 100% count, not the ACS housing collections' pct_owner_occupied estimate. Neither blue nor green: connectivity owns the blue ramp and age the green one, and a blue-green tested too close to connectivity at card size. Pink is the one hue path no other default style in this catalog uses. Measured over all 240,563 block groups with a published value: 6 classes with breaks at 40%/55%/65%/75%/85%, which fall at the 20th/32nd/42nd/56th/76th percentile of the national distribution.",
    "portolan:column": "pct_owned",
    "portolan:breaks": [
      40,
      55,
      65,
      75,
      85
    ]
  },
