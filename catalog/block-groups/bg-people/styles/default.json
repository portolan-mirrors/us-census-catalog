{
  "version": 8,
  "name": "Population density",
  "metadata": {
    "description": "People per square kilometre of land area on roughly logarithmic steps, pale cream (empty) to deep plum (dense). Measured over all 241,652 block groups with a published value: 7 classes with breaks at 25/100/400/1,000/2,500/6,000 people per km\u00b2, which fall at the 11th/21st/34th/51st/77th/92nd percentile of the national distribution.",
    "portolan:column": "pop_density",
    "portolan:breaks": [
      25,
      100,
      400,
      1000,
      2500,
      6000
    ]
  },
