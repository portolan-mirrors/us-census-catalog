{
  "version": 8,
  "name": "People without health insurance",
  "metadata": {
    "description": "Share of the civilian non-institutionalized population with no health insurance coverage, pale yellow to deep red. Measured over all 84,386 tracts with a published value: 6 classes with breaks at 2%/4%/7%/11%/18%, which fall at the 13th/31st/54th/74th/90th percentile of the national distribution. 58.73% of tracts have a coefficient of variation above 0.3 at this geography, too many to fade without washing the map out, so read pct_uninsured_moe in the GeoParquet before drawing a conclusion from any single tract.",
    "portolan:column": "pct_uninsured",
    "portolan:breaks": [
      2,
      4,
      7,
      11,
      18
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../tract-wellbeing.pmtiles"
    }
  },
