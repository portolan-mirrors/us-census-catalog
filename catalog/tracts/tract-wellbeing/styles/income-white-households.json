{
  "version": 8,
  "name": "Median income, white non-Hispanic households",
  "metadata": {
    "description": "Median household income for white, non-Hispanic householders (ACS table B19013H), on the same scale as the Black-household style. Measured over all 76,629 tracts with a published value: 6 classes with breaks at $30k/$45k/$60k/$85k/$120k, which fall at the 2nd/7th/21st/51st/79th percentile of the national distribution. Same breaks, ramp and opacity rule as the Black-household style \u2014 neither fades its noisy estimates, because fading only one of the pair would make the gap look like a difference in confidence. 10.04% have no published value and draw in neutral gray rather than as a low value. 11.81% of tracts have a coefficient of variation above 0.3; this style does not fade them, so read median_hh_income_white_nh_moe in the GeoParquet before drawing a conclusion from any single tract.",
    "portolan:column": "median_hh_income_white_nh",
    "portolan:breaks": [
      30000,
      45000,
      60000,
      85000,
      120000
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../tract-wellbeing.pmtiles"
    }
  },
  "layers": [
    {
      "id": "no-data",
      "type": "fill",
      "source": "data",
      "source-layer": "tract-wellbeing",
      "filter": [
        "!",
        [
          "has",
          "median_hh_income_white_nh"
        ]
      ],
      "paint": {
        "fill-color": "#d9d6d2",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "tract-wellbeing",
      "filter": [
        "has",
        "median_hh_income_white_nh"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "median_hh_income_white_nh"
          ],
          "#00224e",
          30000,
          "#35456c",
          45000,
          "#666970",
          60000,
          "#958f5f",
          85000,
          "#cab969",
          120000,
          "#fee838"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "outline",
      "type": "line",
      "source": "data",
      "source-layer": "tract-wellbeing",
      "minzoom": 8,
      "paint": {
        "line-color": "#4d4d4d",
        "line-width": [
