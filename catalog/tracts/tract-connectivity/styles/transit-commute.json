{
  "version": 8,
  "name": "Commute by public transit",
  "metadata": {
    "description": "Share of workers commuting by public transportation, pale yellow to dark green; the first class is deliberately narrow because most of the country has effectively none. Measured over all 84,378 tracts with a published value: 6 classes with breaks at 0.5%/2%/5%/10%/25%, which fall at the 56th/73rd/84th/91st/97th percentile of the national distribution. 44.78% of tracts have a coefficient of variation above 0.3 at this geography, too many to fade without washing the map out, so read pct_commute_transit_moe in the GeoParquet before drawing a conclusion from any single tract.",
    "portolan:column": "pct_commute_transit",
    "portolan:breaks": [
      0.5,
      2,
      5,
      10,
      25
    ]
  },
