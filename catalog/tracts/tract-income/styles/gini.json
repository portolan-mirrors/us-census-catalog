{
  "version": 8,
  "name": "Income inequality (Gini index)",
  "metadata": {
    "description": "Gini index of household income inequality, 0 (perfect equality) to 1 (perfect inequality), navy (low) to gold (high) \u2014 not published for block groups. Measured over all 84,191 tracts with a published value: 6 classes with breaks at 0.37/0.4/0.43/0.47/0.51, which fall at the 20th/38th/57th/78th/90th percentile of the national distribution.",
    "portolan:column": "gini_index",
    "portolan:breaks": [
      0.37,
      0.4,
      0.43,
      0.47,
      0.51
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../tract-income.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "tract-income",
      "filter": [
        "has",
        "gini_index"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "gini_index"
          ],
          "#00224e",
          0.37,
          "#35456c",
          0.4,
          "#666970",
          0.43,
          "#958f5f",
          0.47,
          "#cab969",
          0.51,
          "#fee838"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "outline",
      "type": "line",
      "source": "data",
      "source-layer": "tract-income",
      "minzoom": 8,
      "paint": {
        "line-color": "#4d4d4d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.2,
          13,
          0.8
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.0,
          10,
          0.45
        ]
      }
    }
  ]
}
