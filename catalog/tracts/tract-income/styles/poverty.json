{
  "version": 8,
  "name": "People below the poverty line",
  "metadata": {
    "description": "Share of residents with income below the federal poverty line, pale yellow to deep red. Measured over all 84,338 tracts with a published value: 6 classes with breaks at 5%/10%/20%/30%/40%, which fall at the 20th/47th/78th/91st/96th percentile of the national distribution. 60.65% of tracts have a coefficient of variation above 0.3 at this geography, too many to fade without washing the map out, so read pct_below_poverty_moe in the GeoParquet before drawing a conclusion from any single tract.",
    "portolan:column": "pct_below_poverty",
    "portolan:breaks": [
      5,
      10,
      20,
      30,
      40
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../tract-income.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "tract-income",
      "filter": [
        "has",
        "pct_below_poverty"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "pct_below_poverty"
          ],
          "#fff2b0",
          5,
          "#fed976",
          10,
          "#feb24c",
          20,
          "#fd8d3c",
          30,
          "#f03b20",
          40,
          "#bd0026"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "outline",
      "type": "line",
      "source": "data",
      "source-layer": "tract-income",
      "minzoom": 8,
      "paint": {
        "line-color": "#4d4d4d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.2,
          13,
          0.8
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.0,
          10,
          0.45
        ]
      }
    }
  ]
}
