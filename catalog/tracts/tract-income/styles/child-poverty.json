{
  "version": 8,
  "name": "Children below the poverty line",
  "metadata": {
    "description": "Share of residents under 18 with income below the federal poverty line, pale pink to deep magenta \u2014 not published for block groups. Measured over all 83,841 tracts with a published value: 6 classes with breaks at 2%/7%/16%/30%/43%, which fall at the 21st/39th/60th/80th/90th percentile of the national distribution.",
    "portolan:column": "pct_below_poverty_under_18",
    "portolan:breaks": [
      2,
      7,
      16,
      30,
      43
    ]
  },
  "sources": {
