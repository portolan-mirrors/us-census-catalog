{
  "version": 8,
  "name": "Vacant housing units",
  "metadata": {
    "description": "Share of housing units vacant, cream to dark red; seasonal and recreational housing drives the high end as much as abandonment does. Measured over all 84,305 tracts with a published value: 6 classes with breaks at 3%/7%/12%/18%/30%, which fall at the 21st/48th/71st/85th/95th percentile of the national distribution.",
    "portolan:column": "pct_vacant_units",
    "portolan:breaks": [
      3,
      7,
      12,
      18,
      30
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../tract-housing.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "tract-housing",
      "filter": [
        "has",
        "pct_vacant_units"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "pct_vacant_units"
          ],
          "#fef0d9",
          3,
          "#fdd49e",
          7,
          "#fdbb84",
          12,
          "#fc8d59",
          18,
          "#e34a33",
          30,
          "#b30000"
        ],
        "fill-opacity": 0.8
      }
    },
    {
