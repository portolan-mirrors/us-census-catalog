{
  "version": 8,
  "name": "Population under 18",
  "metadata": {
    "description": "Share of the 2020 Census population under 18, pale to deep orange -- a 100% count, not the ACS people collections' pct_under_18 estimate. Measured over all 84,781 tracts with a published value: 6 classes with breaks at 18%/22%/26%/30%/35%, which fall at the 22nd/52nd/80th/94th/99th percentile of the national distribution.",
    "portolan:column": "pct_under18",
    "portolan:breaks": [
      18,
      22,
      26,
      30,
      35
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../tract-age-dec2020.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "tract-age-dec2020",
      "filter": [
        "has",
        "pct_under18"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "pct_under18"
          ],
          "#feedde",
          18,
