      "type": "vector",
      "url": "pmtiles://../cd-connectivity.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "cd-connectivity",
      "filter": [
