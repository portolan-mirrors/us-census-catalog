{
  "version": 8,
  "name": "No home internet",
  "metadata": {
    "description": "Share of households with no internet subscription of any kind, pale to deep blue. Measured over all 437 districts with a published value: 6 classes with breaks at 4%/5.5%/7%/8.5%/10%, which fall at the 17th/41st/61st/78th/89th percentile of the national distribution.",
    "portolan:column": "pct_no_internet",
    "portolan:breaks": [
      4,
      5.5,
      7,
      8.5,
      10
    ]
  },
  "sources": {
