{
  "version": 8,
  "name": "Population density",
  "metadata": {
    "description": "People per square kilometre on roughly logarithmic steps, pale cream to deep plum. Measured over all 437 districts with a published value: 7 classes with breaks at 25/75/200/600/1,500/4,000 people per km\u00b2, which fall at the 14th/38th/57th/72nd/86th/95th percentile of the national distribution.",
    "portolan:column": "pop_density",
    "portolan:breaks": [
      25,
      75,
      200,
      600,
      1500,
      4000
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../congressional-districts.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "congressional-districts",
      "filter": [
        "has",
        "pop_density"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "pop_density"
          ],
          "#fcfdbf",
          25,
          "#fec488",
          75,
          "#fe9f6d",
          200,
          "#f1605d",
          600,
          "#b63679",
          1500,
          "#721f81",
          4000,
          "#2d1160"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "outline",
      "type": "line",
      "source": "data",
      "source-layer": "congressional-districts",
      "minzoom": 4,
      "paint": {
        "line-color": "#4d4d4d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.2,
          9,
          0.8
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.0,
          6,
          0.45
        ]
      }
    }
  ]
}
