{
  "version": 8,
  "name": "Vacant housing units",
  "metadata": {
    "description": "Share of housing units vacant, cream to dark red; seasonal and recreational housing drives the high end as much as abandonment does. Measured over all 437 districts with a published value: 6 classes with breaks at 5.5%/8%/10%/13%/17%, which fall at the 19th/40th/62nd/79th/91st percentile of the national distribution.",
    "portolan:column": "pct_vacant_units",
    "portolan:breaks": [
      5.5,
      8,
      10,
      13,
      17
    ]
  },
  "sources": {
