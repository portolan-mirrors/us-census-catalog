{
  "version": 8,
  "name": "Children below the poverty line",
  "metadata": {
    "description": "Share of residents under 18 with income below the federal poverty line, pale pink to deep magenta \u2014 not published for block groups. Measured over all 437 districts with a published value: 6 classes with breaks at 10%/14%/17%/21%/25%, which fall at the 18th/43rd/63rd/80th/90th percentile of the national distribution.",
    "portolan:column": "pct_below_poverty_under_18",
    "portolan:breaks": [
      10,
      14,
      17,
      21,
      25
    ]
  },
