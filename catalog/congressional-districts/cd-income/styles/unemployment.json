{
  "version": 8,
  "name": "Unemployment rate",
  "metadata": {
    "description": "Unemployed share of the civilian labor force, pale lilac to deep purple. Measured over all 437 districts with a published value: 6 classes with breaks at 4%/5%/5.5%/6%/7%, which fall at the 17th/49th/66th/77th/90th percentile of the national distribution.",
    "portolan:column": "pct_unemployed",
    "portolan:breaks": [
      4,
      5,
      5.5,
      6,
      7
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../cd-income.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "cd-income",
      "filter": [
        "has",
        "pct_unemployed"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "pct_unemployed"
          ],
          "#f2f0f7",
          4,
          "#dadaeb",
          5,
          "#bcbddc",
          5.5,
          "#9e9ac8",
          6,
          "#756bb1",
          7,
          "#54278f"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "outline",
      "type": "line",
      "source": "data",
      "source-layer": "cd-income",
      "minzoom": 4,
      "paint": {
        "line-color": "#4d4d4d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.2,
          9,
          0.8
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.0,
          6,
          0.45
        ]
      }
    }
  ]
}
