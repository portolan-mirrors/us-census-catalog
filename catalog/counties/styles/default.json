{
  "version": 8,
  "name": "Median household income",
  "metadata": {
    "description": "Median household income by county, viridis dark purple (low) to yellow (high). Measured over all 3,221 counties with a published value: 7 classes with breaks at $45k/$55k/$65k/$75k/$90k/$110k, which fall at the 8th/23rd/49th/74th/91st/97th percentile of the national distribution. 0.25% have a coefficient of variation above 0.3 and render faded \u2014 the estimate is real but its margin of error swamps it.",
    "portolan:column": "median_hh_income",
    "portolan:breaks": [
      45000,
      55000,
      65000,
      75000,
      90000,
      110000
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../counties.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "counties",
      "filter": [
        "has",
        "median_hh_income"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "median_hh_income"
          ],
          "#440154",
          45000,
          "#443983",
          55000,
          "#31688e",
          65000,
          "#21918c",
          75000,
          "#35b779",
          90000,
          "#90d743",
          110000,
          "#fde725"
        ],
        "fill-opacity": [
          "case",
          [
            ">",
            [
              "coalesce",
              [
                "get",
                "median_hh_income_cv"
              ],
              0
            ],
            0.3
          ],
          0.35,
          0.8
        ]
      }
    },
    {
