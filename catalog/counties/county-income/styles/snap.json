{
  "version": 8,
  "name": "Households receiving SNAP",
  "metadata": {
    "description": "Share of households that received SNAP (food stamps) in the past 12 months, cream to dark red. Measured over all 3,222 counties with a published value: 6 classes with breaks at 7%/10%/14%/17%/24%, which fall at the 19th/38th/62nd/77th/92nd percentile of the national distribution.",
    "portolan:column": "pct_snap",
    "portolan:breaks": [
      7,
      10,
      14,
      17,
      24
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../county-income.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "county-income",
      "filter": [
        "has",
        "pct_snap"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "pct_snap"
          ],
          "#fef0d9",
          7,
          "#fdd49e",
          10,
          "#fdbb84",
          14,
          "#fc8d59",
          17,
          "#e34a33",
          24,
          "#b30000"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "outline",
      "type": "line",
      "source": "data",
      "source-layer": "county-income",
      "minzoom": 4,
      "paint": {
        "line-color": "#4d4d4d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.2,
          9,
          0.8
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.0,
          6,
          0.45
        ]
      }
    }
  ]
}
