{
  "version": 8,
  "name": "People below the poverty line",
  "metadata": {
    "description": "Share of residents with income below the federal poverty line, pale yellow to deep red. Measured over all 3,222 counties with a published value: 6 classes with breaks at 8%/11%/14%/18%/25%, which fall at the 11th/31st/55th/76th/93rd percentile of the national distribution. 2.39% have a coefficient of variation above 0.3 and render faded \u2014 the estimate is real but its margin of error swamps it.",
    "portolan:column": "pct_below_poverty",
    "portolan:breaks": [
      8,
      11,
      14,
      18,
      25
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../county-income.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "county-income",
      "filter": [
        "has",
        "pct_below_poverty"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "pct_below_poverty"
          ],
          "#fff2b0",
          8,
          "#fed976",
          11,
          "#feb24c",
          14,
          "#fd8d3c",
          18,
          "#f03b20",
          25,
          "#bd0026"
        ],
        "fill-opacity": [
          "case",
          [
            ">",
            [
              "coalesce",
              [
                "get",
                "pct_below_poverty_cv"
              ],
              0
            ],
            0.3
          ],
          0.35,
          0.8
        ]
      }
    },
    {
      "id": "outline",
      "type": "line",
      "source": "data",
      "source-layer": "county-income",
      "minzoom": 4,
      "paint": {
        "line-color": "#4d4d4d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.2,
          9,
          0.8
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.0,
          6,
          0.45
        ]
      }
    }
  ]
}
