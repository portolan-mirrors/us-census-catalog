{
  "version": 8,
  "name": "Median home value",
  "metadata": {
    "description": "Median value of owner-occupied homes, pale amber to burnt brown. Measured over all 3,217 counties with a published value: 7 classes with breaks at $110k/$150k/$200k/$275k/$400k/$650k, which fall at the 11th/30th/56th/76th/91st/98th percentile of the national distribution. 0.5% have a coefficient of variation above 0.3 and render faded \u2014 the estimate is real but its margin of error swamps it.",
    "portolan:column": "median_home_value",
    "portolan:breaks": [
      110000,
      150000,
      200000,
      275000,
      400000,
      650000
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../county-housing.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "county-housing",
      "filter": [
        "has",
        "median_home_value"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "median_home_value"
          ],
          "#fff3c0",
          110000,
          "#fee391",
          150000,
          "#fec44f",
          200000,
          "#fe9929",
          275000,
          "#ec7014",
          400000,
          "#cc4c02",
          650000,
          "#8c2d04"
        ],
        "fill-opacity": [
          "case",
          [
            ">",
            [
              "coalesce",
              [
                "get",
                "median_home_value_cv"
              ],
              0
            ],
            0.3
          ],
          0.35,
          0.8
        ]
      }
    },
    {
      "id": "outline",
      "type": "line",
      "source": "data",
      "source-layer": "county-housing",
      "minzoom": 4,
      "paint": {
        "line-color": "#4d4d4d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.2,
          9,
          0.8
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.0,
          6,
          0.45
        ]
      }
    }
  ]
}
