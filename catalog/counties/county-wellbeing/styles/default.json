{
  "version": 8,
  "name": "People without health insurance",
  "metadata": {
    "description": "Share of the civilian non-institutionalized population with no health insurance coverage, pale yellow to deep red. Measured over all 3,222 counties with a published value: 6 classes with breaks at 5%/6.5%/9%/12%/16%, which fall at the 20th/38th/60th/79th/92nd percentile of the national distribution. 3.66% have a coefficient of variation above 0.3 and render faded \u2014 the estimate is real but its margin of error swamps it.",
    "portolan:column": "pct_uninsured",
    "portolan:breaks": [
      5,
      6.5,
      9,
      12,
      16
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../county-wellbeing.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "county-wellbeing",
      "filter": [
        "has",
        "pct_uninsured"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "pct_uninsured"
          ],
          "#fff2b0",
          5,
          "#fed976",
          6.5,
          "#feb24c",
          9,
          "#fd8d3c",
          12,
          "#f03b20",
          16,
          "#bd0026"
        ],
        "fill-opacity": [
          "case",
          [
            ">",
            [
              "coalesce",
              [
                "get",
                "pct_uninsured_cv"
              ],
              0
            ],
            0.3
          ],
          0.35,
          0.8
        ]
      }
    },
    {
      "id": "outline",
      "type": "line",
      "source": "data",
      "source-layer": "county-wellbeing",
      "minzoom": 4,
      "paint": {
        "line-color": "#4d4d4d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.2,
          9,
          0.8
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.0,
          6,
          0.45
        ]
      }
    }
  ]
}
