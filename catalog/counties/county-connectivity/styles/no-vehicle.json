{
  "version": 8,
  "name": "Households without a vehicle",
  "metadata": {
    "description": "Share of households with no vehicle available, pale yellow through teal to navy. Measured over all 3,222 counties with a published value: 6 classes with breaks at 3.5%/5%/6%/7.5%/10%, which fall at the 18th/42nd/59th/77th/90th percentile of the national distribution. 14.71% have a coefficient of variation above 0.3 and render faded \u2014 the estimate is real but its margin of error swamps it.",
    "portolan:column": "pct_hh_no_vehicle",
    "portolan:breaks": [
      3.5,
      5,
      6,
      7.5,
      10
    ]
  },
