{
  "version": 8,
  "name": "White, non-Hispanic share",
  "metadata": {
    "description": "Share of residents who are white alone and not Hispanic or Latino, pale to deep blue. Measured over all 5,806,512 blocks with a published value: 7 classes with breaks at 10%/30%/50%/70%/85%/95%, which fall at the 12th/20th/30th/47th/65th/80th percentile of the national distribution. 28.97% have no published value and draw in neutral gray rather than as a low value.",
    "portolan:column": "pct_white_nh",
    "portolan:breaks": [
      10,
      30,
      50,
      70,
      85,
      95
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../blocks.pmtiles"
    }
  },
  "layers": [
