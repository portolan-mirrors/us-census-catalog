{
  "version": 8,
  "name": "Median home value",
  "metadata": {
    "description": "Median value of owner-occupied homes, pale amber to burnt brown. Measured over all 28,443 places with a published value: 7 classes with breaks at $85k/$130k/$190k/$290k/$450k/$750k, which fall at the 11th/30th/50th/70th/85th/95th percentile of the national distribution. 12.78% have no published value and draw in neutral gray rather than as a low value. 10.29% have a coefficient of variation above 0.3 and render faded \u2014 the estimate is real but its margin of error swamps it.",
    "portolan:column": "median_home_value",
    "portolan:breaks": [
      85000,
      130000,
      190000,
      290000,
      450000,
      750000
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../place-housing.pmtiles"
    }
  },
  "layers": [
