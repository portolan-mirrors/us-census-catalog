{
  "version": 8,
  "name": "No home internet",
  "metadata": {
    "description": "Share of households with no internet subscription of any kind, pale to deep blue. Measured over all 31,711 places with a published value: 6 classes with breaks at 2%/5.5%/9.5%/15%/24%, which fall at the 19th/39th/60th/79th/91st percentile of the national distribution. 66.72% of places have a coefficient of variation above 0.3 at this geography, too many to fade without washing the map out, so read pct_no_internet_moe in the GeoParquet before drawing a conclusion from any single place.",
    "portolan:column": "pct_no_internet",
    "portolan:breaks": [
      2,
      5.5,
      9.5,
      15,
      24
    ]
  },
