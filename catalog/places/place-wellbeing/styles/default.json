{
  "version": 8,
  "name": "People without health insurance",
  "metadata": {
    "description": "Share of the civilian non-institutionalized population with no health insurance coverage, pale yellow to deep red. Measured over all 31,808 places with a published value: 6 classes with breaks at 2%/4.5%/7.5%/12%/19%, which fall at the 21st/41st/60th/78th/91st percentile of the national distribution. 61.01% of places have a coefficient of variation above 0.3 at this geography, too many to fade without washing the map out, so read pct_uninsured_moe in the GeoParquet before drawing a conclusion from any single place.",
    "portolan:column": "pct_uninsured",
    "portolan:breaks": [
      2,
      4.5,
      7.5,
      12,
      19
    ]
  },
