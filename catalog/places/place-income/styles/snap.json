{
  "version": 8,
  "name": "Households receiving SNAP",
  "metadata": {
    "description": "Share of households that received SNAP (food stamps) in the past 12 months, cream to dark red. Measured over all 31,711 places with a published value: 6 classes with breaks at 2.5%/7.5%/13%/21%/32%, which fall at the 20th/39th/58th/78th/91st percentile of the national distribution.",
    "portolan:column": "pct_snap",
    "portolan:breaks": [
      2.5,
      7.5,
      13,
      21,
      32
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../place-income.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "place-income",
      "filter": [
        "has",
        "pct_snap"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "pct_snap"
          ],
          "#fef0d9",
          2.5,
          "#fdd49e",
          7.5,
          "#fdbb84",
          13,
          "#fc8d59",
          21,
          "#e34a33",
          32,
          "#b30000"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "outline",
      "type": "line",
      "source": "data",
      "source-layer": "place-income",
      "minzoom": 8,
      "paint": {
        "line-color": "#4d4d4d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.2,
          13,
          0.8
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.0,
          10,
          0.45
        ]
      }
    }
  ]
}
