{
  "version": 8,
  "name": "Median household income",
  "metadata": {
    "description": "Median household income, viridis dark purple (low) through teal and green to yellow (high). Measured over all 28,468 places with a published value: 7 classes with breaks at $40k/$55k/$67k/$84k/$115k/$150k, which fall at the 10th/30th/50th/70th/88th/95th percentile of the national distribution. 12.71% have no published value and draw in neutral gray rather than as a low value. 15.41% have a coefficient of variation above 0.3 and render faded \u2014 the estimate is real but its margin of error swamps it.",
    "portolan:column": "median_hh_income",
    "portolan:breaks": [
      40000,
      55000,
      67000,
      84000,
      115000,
      150000
    ]
  },
