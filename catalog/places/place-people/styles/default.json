{
  "version": 8,
  "name": "Population density",
  "metadata": {
    "description": "People per square kilometre of land area on roughly logarithmic steps, pale cream (empty) to deep plum (dense). Measured over all 32,330 places with a published value: 7 classes with breaks at 50/125/250/500/1,000/2,000 people per km\u00b2, which fall at the 15th/30th/47th/70th/87th/96th percentile of the national distribution.",
    "portolan:column": "pop_density",
    "portolan:breaks": [
      50,
      125,
      250,
      500,
      1000,
      2000
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../place-people.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "place-people",
      "filter": [
        "has",
        "pop_density"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "pop_density"
          ],
          "#fcfdbf",
          50,
          "#fec488",
          125,
          "#fe9f6d",
          250,
          "#f1605d",
          500,
          "#b63679",
          1000,
          "#721f81",
          2000,
          "#2d1160"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "outline",
      "type": "line",
      "source": "data",
      "source-layer": "place-people",
      "minzoom": 8,
      "paint": {
        "line-color": "#4d4d4d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.2,
          13,
          0.8
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.0,
          10,
          0.45
        ]
      }
    }
  ]
}
