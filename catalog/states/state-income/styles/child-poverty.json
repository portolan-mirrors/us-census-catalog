{
  "version": 8,
  "name": "Children below the poverty line",
  "metadata": {
    "description": "Share of residents under 18 with income below the federal poverty line, pale pink to deep magenta \u2014 not published for block groups. Measured over all 52 states and state equivalents with a published value: 6 classes with breaks at 10%/13%/16%/19%/22%, which fall at the 4th/37th/58th/79th/90th percentile of the national distribution. 7.14% have no published value and draw in neutral gray rather than as a low value.",
    "portolan:column": "pct_below_poverty_under_18",
    "portolan:breaks": [
      10,
      13,
      16,
      19,
      22
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../state-income.pmtiles"
    }
  },
  "layers": [
    {
      "id": "no-data",
      "type": "fill",
      "source": "data",
      "source-layer": "state-income",
      "filter": [
        "!",
        [
          "has",
          "pct_below_poverty_under_18"
        ]
      ],
      "paint": {
        "fill-color": "#d9d6d2",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "state-income",
      "filter": [
        "has",
        "pct_below_poverty_under_18"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "pct_below_poverty_under_18"
          ],
          "#feebe2",
          10,
          "#fcc5c0",
          13,
          "#fa9fb5",
          16,
          "#f768a1",
          19,
          "#dd3497",
          22,
          "#7a0177"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "outline",
      "type": "line",
      "source": "data",
      "source-layer": "state-income",
      "minzoom": 4,
      "paint": {
        "line-color": "#4d4d4d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.2,
          9,
          0.8
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.0,
          6,
          0.45
        ]
      }
    }
  ]
}
