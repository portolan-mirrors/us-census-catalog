{
  "version": 8,
  "name": "Income inequality (Gini index)",
  "metadata": {
    "description": "Gini index of household income inequality, 0 (perfect equality) to 1 (perfect inequality), navy (low) to gold (high) \u2014 not published for block groups. Measured over all 52 states and state equivalents with a published value: 6 classes with breaks at 0.45/0.46/0.47/0.48/0.49, which fall at the 15th/37th/56th/81st/90th percentile of the national distribution. 7.14% have no published value and draw in neutral gray rather than as a low value.",
    "portolan:column": "gini_index",
    "portolan:breaks": [
      0.45,
      0.46,
      0.47,
      0.48,
      0.49
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../state-income.pmtiles"
    }
  },
  "layers": [
    {
      "id": "no-data",
      "type": "fill",
      "source": "data",
      "source-layer": "state-income",
      "filter": [
        "!",
        [
          "has",
          "gini_index"
        ]
      ],
      "paint": {
        "fill-color": "#d9d6d2",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "state-income",
      "filter": [
        "has",
        "gini_index"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "gini_index"
          ],
          "#00224e",
          0.45,
          "#35456c",
          0.46,
          "#666970",
          0.47,
          "#958f5f",
          0.48,
          "#cab969",
          0.49,
          "#fee838"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "outline",
      "type": "line",
      "source": "data",
      "source-layer": "state-income",
      "minzoom": 4,
      "paint": {
        "line-color": "#4d4d4d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.2,
          9,
          0.8
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.0,
          6,
          0.45
        ]
      }
    }
  ]
}
