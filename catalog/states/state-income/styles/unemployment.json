{
  "version": 8,
  "name": "Unemployment rate",
  "metadata": {
    "description": "Unemployed share of the civilian labor force, pale lilac to deep purple. Measured over all 52 states and state equivalents with a published value: 6 classes with breaks at 3.5%/4.5%/5%/6%/6.5%, which fall at the 10th/33rd/56th/87th/94th percentile of the national distribution. 7.14% have no published value and draw in neutral gray rather than as a low value.",
    "portolan:column": "pct_unemployed",
    "portolan:breaks": [
      3.5,
      4.5,
      5,
      6,
      6.5
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../state-income.pmtiles"
    }
  },
  "layers": [
    {
      "id": "no-data",
      "type": "fill",
      "source": "data",
      "source-layer": "state-income",
      "filter": [
        "!",
        [
          "has",
          "pct_unemployed"
        ]
      ],
      "paint": {
        "fill-color": "#d9d6d2",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "state-income",
      "filter": [
        "has",
        "pct_unemployed"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "pct_unemployed"
          ],
          "#f2f0f7",
          3.5,
          "#dadaeb",
          4.5,
          "#bcbddc",
          5,
          "#9e9ac8",
          6,
          "#756bb1",
          6.5,
          "#54278f"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "outline",
      "type": "line",
      "source": "data",
      "source-layer": "state-income",
      "minzoom": 4,
      "paint": {
        "line-color": "#4d4d4d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.2,
          9,
          0.8
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.0,
          6,
          0.45
        ]
      }
    }
  ]
}
