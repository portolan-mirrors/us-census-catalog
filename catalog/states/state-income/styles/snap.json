{
  "version": 8,
  "name": "Households receiving SNAP",
  "metadata": {
    "description": "Share of households that received SNAP (food stamps) in the past 12 months, cream to dark red. Measured over all 52 states and state equivalents with a published value: 6 classes with breaks at 8.5%/11%/12%/14%/16%, which fall at the 21st/44th/58th/79th/90th percentile of the national distribution. 7.14% have no published value and draw in neutral gray rather than as a low value.",
    "portolan:column": "pct_snap",
    "portolan:breaks": [
      8.5,
      11,
      12,
      14,
      16
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../state-income.pmtiles"
    }
  },
  "layers": [
    {
      "id": "no-data",
      "type": "fill",
      "source": "data",
      "source-layer": "state-income",
      "filter": [
        "!",
        [
          "has",
          "pct_snap"
        ]
      ],
      "paint": {
        "fill-color": "#d9d6d2",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "state-income",
      "filter": [
        "has",
        "pct_snap"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "pct_snap"
          ],
          "#fef0d9",
          8.5,
          "#fdd49e",
          11,
          "#fdbb84",
          12,
          "#fc8d59",
          14,
          "#e34a33",
          16,
          "#b30000"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "outline",
      "type": "line",
      "source": "data",
      "source-layer": "state-income",
      "minzoom": 4,
      "paint": {
        "line-color": "#4d4d4d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.2,
          9,
          0.8
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.0,
          6,
          0.45
        ]
      }
    }
  ]
}
