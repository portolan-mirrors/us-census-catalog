{
  "version": 8,
  "name": "People below the poverty line",
  "metadata": {
    "description": "Share of residents with income below the federal poverty line, pale yellow to deep red. Measured over all 52 states and state equivalents with a published value: 6 classes with breaks at 10%/12%/14%/17%/22%, which fall at the 15th/54th/77th/92nd/98th percentile of the national distribution. 7.14% have no published value and draw in neutral gray rather than as a low value.",
    "portolan:column": "pct_below_poverty",
    "portolan:breaks": [
      10,
      12,
      14,
      17,
      22
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../states.pmtiles"
    }
  },
  "layers": [
    {
      "id": "no-data",
      "type": "fill",
      "source": "data",
      "source-layer": "states",
      "filter": [
        "!",
        [
          "has",
          "pct_below_poverty"
        ]
      ],
      "paint": {
        "fill-color": "#d9d6d2",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "states",
      "filter": [
        "has",
        "pct_below_poverty"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "pct_below_poverty"
          ],
          "#fff2b0",
          10,
          "#fed976",
          12,
          "#feb24c",
          14,
          "#fd8d3c",
          17,
          "#f03b20",
          22,
          "#bd0026"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "outline",
      "type": "line",
      "source": "data",
      "source-layer": "states",
      "minzoom": 4,
      "paint": {
        "line-color": "#4d4d4d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.2,
          9,
          0.8
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.0,
          6,
          0.45
        ]
      }
    }
  ]
}
