{
  "version": 8,
  "name": "Median income, white non-Hispanic households",
  "metadata": {
    "description": "Median household income for white, non-Hispanic householders (ACS table B19013H), on the same scale as the Black-household style. Measured over all 52 states and state equivalents with a published value: 6 classes with breaks at $45k/$62.5k/$70k/$75k/$80k, which fall at the 2nd/4th/10th/23rd/44th percentile of the national distribution. Same breaks, ramp and opacity rule as the Black-household style \u2014 neither fades its noisy estimates, because fading only one of the pair would make the gap look like a difference in confidence. 7.14% have no published value and draw in neutral gray rather than as a low value.",
    "portolan:column": "median_hh_income_white_nh",
    "portolan:breaks": [
      45000,
      62500,
      70000,
      75000,
      80000
    ]
  },
