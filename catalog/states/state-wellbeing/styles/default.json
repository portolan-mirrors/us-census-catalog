{
  "version": 8,
  "name": "People without health insurance",
  "metadata": {
    "description": "Share of the civilian non-institutionalized population with no health insurance coverage, pale yellow to deep red. Measured over all 52 states and state equivalents with a published value: 6 classes with breaks at 5.5%/6.5%/8.5%/9.5%/11%, which fall at the 23rd/44th/62nd/75th/85th percentile of the national distribution. 7.14% have no published value and draw in neutral gray rather than as a low value.",
    "portolan:column": "pct_uninsured",
    "portolan:breaks": [
      5.5,
      6.5,
      8.5,
      9.5,
      11
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../state-wellbeing.pmtiles"
    }
  },
  "layers": [
    {
      "id": "no-data",
      "type": "fill",
      "source": "data",
      "source-layer": "state-wellbeing",
      "filter": [
        "!",
        [
          "has",
          "pct_uninsured"
        ]
      ],
      "paint": {
        "fill-color": "#d9d6d2",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "state-wellbeing",
      "filter": [
        "has",
        "pct_uninsured"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "pct_uninsured"
          ],
          "#fff2b0",
          5.5,
          "#fed976",
          6.5,
          "#feb24c",
          8.5,
          "#fd8d3c",
          9.5,
          "#f03b20",
          11,
          "#bd0026"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "outline",
      "type": "line",
      "source": "data",
      "source-layer": "state-wellbeing",
      "minzoom": 4,
      "paint": {
        "line-color": "#4d4d4d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.2,
          9,
          0.8
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.0,
          6,
          0.45
        ]
      }
    }
  ]
}
