{
  "version": 8,
  "name": "Foreign-born residents",
  "metadata": {
    "description": "Share of residents born outside the United States, pale green to deep blue. Measured over all 52 states and state equivalents with a published value: 6 classes with breaks at 4.5%/6%/9.5%/15%/19%, which fall at the 19th/37th/62nd/77th/90th percentile of the national distribution. 7.14% have no published value and draw in neutral gray rather than as a low value.",
    "portolan:column": "pct_foreign_born",
    "portolan:breaks": [
      4.5,
      6,
      9.5,
      15,
      19
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../state-wellbeing.pmtiles"
    }
  },
  "layers": [
    {
      "id": "no-data",
      "type": "fill",
      "source": "data",
      "source-layer": "state-wellbeing",
      "filter": [
        "!",
        [
          "has",
          "pct_foreign_born"
        ]
      ],
      "paint": {
        "fill-color": "#d9d6d2",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "state-wellbeing",
      "filter": [
        "has",
        "pct_foreign_born"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "pct_foreign_born"
          ],
          "#f0f9e8",
          4.5,
          "#ccebc5",
          6,
          "#a8ddb5",
          9.5,
          "#7bccc4",
          15,
          "#43a2ca",
          19,
          "#0868ac"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "outline",
      "type": "line",
      "source": "data",
      "source-layer": "state-wellbeing",
      "minzoom": 4,
      "paint": {
        "line-color": "#4d4d4d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.2,
          9,
          0.8
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.0,
          6,
          0.45
        ]
      }
    }
  ]
}
