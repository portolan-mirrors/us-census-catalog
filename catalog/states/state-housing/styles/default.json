{
  "version": 8,
  "name": "Median home value",
  "metadata": {
    "description": "Median value of owner-occupied homes, pale amber to burnt brown. Measured over all 52 states and state equivalents with a published value: 7 classes with breaks at $175k/$225k/$275k/$350k/$450k/$600k, which fall at the 6th/23rd/42nd/58th/83rd/94th percentile of the national distribution. 7.14% have no published value and draw in neutral gray rather than as a low value.",
    "portolan:column": "median_home_value",
    "portolan:breaks": [
      175000,
      225000,
      275000,
      350000,
      450000,
      600000
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../state-housing.pmtiles"
    }
  },
  "layers": [
    {
      "id": "no-data",
      "type": "fill",
      "source": "data",
      "source-layer": "state-housing",
      "filter": [
        "!",
        [
          "has",
          "median_home_value"
        ]
      ],
      "paint": {
        "fill-color": "#d9d6d2",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "state-housing",
      "filter": [
        "has",
        "median_home_value"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "median_home_value"
          ],
          "#fff3c0",
          175000,
          "#fee391",
          225000,
          "#fec44f",
          275000,
          "#fe9929",
          350000,
          "#ec7014",
          450000,
          "#cc4c02",
          600000,
          "#8c2d04"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "outline",
      "type": "line",
      "source": "data",
      "source-layer": "state-housing",
      "minzoom": 4,
      "paint": {
        "line-color": "#4d4d4d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.2,
          9,
          0.8
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.0,
          6,
          0.45
        ]
      }
    }
  ]
}
