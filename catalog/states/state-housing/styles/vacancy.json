{
  "version": 8,
  "name": "Vacant housing units",
  "metadata": {
    "description": "Share of housing units vacant, cream to dark red; seasonal and recreational housing drives the high end as much as abandonment does. Measured over all 52 states and state equivalents with a published value: 6 classes with breaks at 8%/9.5%/12%/13%/15%, which fall at the 15th/40th/63rd/71st/90th percentile of the national distribution. 7.14% have no published value and draw in neutral gray rather than as a low value.",
    "portolan:column": "pct_vacant_units",
    "portolan:breaks": [
      8,
      9.5,
      12,
      13,
      15
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../state-housing.pmtiles"
    }
  },
  "layers": [
    {
      "id": "no-data",
      "type": "fill",
      "source": "data",
      "source-layer": "state-housing",
      "filter": [
        "!",
        [
          "has",
          "pct_vacant_units"
        ]
      ],
      "paint": {
        "fill-color": "#d9d6d2",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "state-housing",
      "filter": [
        "has",
        "pct_vacant_units"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "pct_vacant_units"
          ],
          "#fef0d9",
          8,
          "#fdd49e",
          9.5,
          "#fdbb84",
          12,
          "#fc8d59",
          13,
          "#e34a33",
          15,
          "#b30000"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "outline",
      "type": "line",
      "source": "data",
      "source-layer": "state-housing",
      "minzoom": 4,
      "paint": {
        "line-color": "#4d4d4d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.2,
          9,
          0.8
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.0,
          6,
          0.45
        ]
      }
    }
  ]
}
