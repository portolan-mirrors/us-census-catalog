{
  "version": 8,
  "name": "Owner-occupied homes",
  "metadata": {
    "description": "Share of occupied housing units lived in by their owner, pale to deep green. Measured over all 52 states and state equivalents with a published value: 7 classes with breaks at 60%/64%/67%/70%/72%/74%, which fall at the 8th/23rd/40th/71st/85th/96th percentile of the national distribution. 7.14% have no published value and draw in neutral gray rather than as a low value.",
    "portolan:column": "pct_owner_occupied",
    "portolan:breaks": [
      60,
      64,
      67,
      70,
      72,
      74
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../state-housing.pmtiles"
    }
  },
  "layers": [
    {
      "id": "no-data",
      "type": "fill",
      "source": "data",
      "source-layer": "state-housing",
      "filter": [
        "!",
        [
          "has",
          "pct_owner_occupied"
        ]
      ],
      "paint": {
        "fill-color": "#d9d6d2",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "state-housing",
      "filter": [
        "has",
        "pct_owner_occupied"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "pct_owner_occupied"
          ],
          "#edf8e9",
          60,
          "#c7e9c0",
          64,
          "#a1d99b",
          67,
          "#74c476",
          70,
          "#41ab5d",
          72,
          "#238b45",
          74,
          "#005a32"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "outline",
      "type": "line",
      "source": "data",
      "source-layer": "state-housing",
      "minzoom": 4,
      "paint": {
        "line-color": "#4d4d4d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.2,
          9,
          0.8
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.0,
          6,
          0.45
        ]
      }
    }
  ]
}
