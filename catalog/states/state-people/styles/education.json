{
  "version": 8,
  "name": "Bachelor's degree or higher",
  "metadata": {
    "description": "Share of adults 25 and over holding a bachelor's degree or more, pale aqua to deep teal. Measured over all 52 states and state equivalents with a published value: 7 classes with breaks at 28%/32%/35%/38%/42%/45%, which fall at the 12th/35th/54th/77th/85th/94th percentile of the national distribution. 7.14% have no published value and draw in neutral gray rather than as a low value.",
    "portolan:column": "pct_bachelors_plus",
    "portolan:breaks": [
      28,
      32,
      35,
      38,
      42,
      45
    ]
  },
