{
  "version": 8,
  "name": "Population density",
  "metadata": {
    "description": "People per square kilometre of land area on roughly logarithmic steps, pale cream (empty) to deep plum (dense). Measured over all 52 states and state equivalents with a published value: 7 classes with breaks at 5/15/40/80/150/400 people per km\u00b2, which fall at the 10th/19th/46th/67th/81st/94th percentile of the national distribution. 7.14% have no published value and draw in neutral gray rather than as a low value.",
    "portolan:column": "pop_density",
    "portolan:breaks": [
      5,
      15,
      40,
      80,
      150,
      400
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../state-people.pmtiles"
    }
  },
  "layers": [
    {
      "id": "no-data",
      "type": "fill",
      "source": "data",
      "source-layer": "state-people",
      "filter": [
        "!",
        [
          "has",
          "pop_density"
        ]
      ],
      "paint": {
        "fill-color": "#d9d6d2",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "state-people",
      "filter": [
        "has",
        "pop_density"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "pop_density"
          ],
          "#fcfdbf",
          5,
          "#fec488",
          15,
          "#fe9f6d",
          40,
          "#f1605d",
          80,
          "#b63679",
          150,
          "#721f81",
          400,
          "#2d1160"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "outline",
      "type": "line",
      "source": "data",
      "source-layer": "state-people",
      "minzoom": 4,
      "paint": {
        "line-color": "#4d4d4d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.2,
          9,
          0.8
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.0,
          6,
          0.45
        ]
      }
    }
  ]
}
