{
  "version": 8,
  "name": "Commute by public transit",
  "metadata": {
    "description": "Share of workers commuting by public transportation, pale yellow to dark green; the first class is deliberately narrow because most of the country has effectively none. Measured over all 52 states and state equivalents with a published value: 6 classes with breaks at 0.5%/1%/3%/8%/20%, which fall at the 19th/54th/81st/94th/96th percentile of the national distribution. 7.14% have no published value and draw in neutral gray rather than as a low value.",
    "portolan:column": "pct_commute_transit",
    "portolan:breaks": [
      0.5,
      1,
      3,
      8,
      20
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../state-connectivity.pmtiles"
    }
  },
  "layers": [
    {
      "id": "no-data",
      "type": "fill",
      "source": "data",
      "source-layer": "state-connectivity",
      "filter": [
        "!",
        [
          "has",
          "pct_commute_transit"
        ]
      ],
      "paint": {
        "fill-color": "#d9d6d2",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "state-connectivity",
      "filter": [
        "has",
        "pct_commute_transit"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "pct_commute_transit"
          ],
          "#f2f7b0",
          0.5,
          "#d9f0a3",
          1,
          "#addd8e",
          3,
          "#78c679",
          8,
          "#31a354",
          20,
          "#006837"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "outline",
      "type": "line",
      "source": "data",
      "source-layer": "state-connectivity",
      "minzoom": 4,
      "paint": {
        "line-color": "#4d4d4d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.2,
          9,
          0.8
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.0,
          6,
          0.45
        ]
      }
    }
  ]
}
