{
  "version": 8,
  "name": "Unemployment rate",
  "metadata": {
    "description": "Unemployed share of the civilian labor force, pale lilac to deep purple. Measured over all 32,807 ZIP Code Tabulation Areas with a published value: 6 classes with breaks at 1%/3%/4.5%/6.5%/10%, which fall at the 19th/39th/58th/77th/90th percentile of the national distribution.",
    "portolan:column": "pct_unemployed",
    "portolan:breaks": [
      1,
      3,
      4.5,
      6.5,
      10
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../zcta-income.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "zcta-income",
      "filter": [
        "has",
        "pct_unemployed"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "pct_unemployed"
          ],
          "#f2f0f7",
          1,
          "#dadaeb",
          3,
          "#bcbddc",
          4.5,
          "#9e9ac8",
          6.5,
          "#756bb1",
          10,
          "#54278f"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "outline",
      "type": "line",
      "source": "data",
      "source-layer": "zcta-income",
      "minzoom": 8,
      "paint": {
        "line-color": "#4d4d4d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.2,
          13,
          0.8
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.0,
          10,
          0.45
        ]
      }
    }
  ]
}
