{
  "version": 8,
  "name": "Children below the poverty line",
  "metadata": {
    "description": "Share of residents under 18 with income below the federal poverty line, pale pink to deep magenta \u2014 not published for block groups. Measured over all 31,348 ZIP Code Tabulation Areas with a published value: 6 classes with breaks at 2%/8%/15%/27%/38%, which fall at the 20th/40th/59th/80th/90th percentile of the national distribution. 7.23% have no published value and draw in neutral gray rather than as a low value.",
    "portolan:column": "pct_below_poverty_under_18",
    "portolan:breaks": [
      2,
      8,
      15,
      27,
      38
    ]
  },
