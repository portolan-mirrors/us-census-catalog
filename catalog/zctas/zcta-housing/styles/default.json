{
  "version": 8,
  "name": "Median home value",
  "metadata": {
    "description": "Median value of owner-occupied homes, pale amber to burnt brown. Measured over all 30,260 ZIP Code Tabulation Areas with a published value: 7 classes with breaks at $100k/$160k/$225k/$325k/$500k/$800k, which fall at the 10th/30th/51st/70th/87th/95th percentile of the national distribution. 10.45% have no published value and draw in neutral gray rather than as a low value. 7.93% have a coefficient of variation above 0.3 and render faded \u2014 the estimate is real but its margin of error swamps it.",
    "portolan:column": "median_home_value",
    "portolan:breaks": [
      100000,
      160000,
      225000,
      325000,
      500000,
      800000
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../zcta-housing.pmtiles"
    }
  },
  "layers": [
    {
      "id": "no-data",
      "type": "fill",
      "source": "data",
      "source-layer": "zcta-housing",
      "filter": [
        "!",
        [
          "has",
          "median_home_value"
        ]
      ],
      "paint": {
        "fill-color": "#d9d6d2",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "zcta-housing",
      "filter": [
        "has",
        "median_home_value"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "median_home_value"
          ],
          "#fff3c0",
          100000,
          "#fee391",
          160000,
          "#fec44f",
          225000,
          "#fe9929",
          325000,
          "#ec7014",
          500000,
          "#cc4c02",
          800000,
          "#8c2d04"
        ],
        "fill-opacity": [
          "case",
          [
            ">",
            [
              "coalesce",
              [
                "get",
                "median_home_value_cv"
              ],
              0
            ],
            0.3
          ],
          0.35,
          0.8
        ]
