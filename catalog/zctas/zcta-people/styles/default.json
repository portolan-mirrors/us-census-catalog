{
  "version": 8,
  "name": "Population density",
  "metadata": {
    "description": "People per square kilometre of land area on roughly logarithmic steps, pale cream (empty) to deep plum (dense). Measured over all 33,772 ZIP Code Tabulation Areas with a published value: 7 classes with breaks at 5/20/60/200/600/2,000 people per km\u00b2, which fall at the 20th/43rd/60th/72nd/82nd/94th percentile of the national distribution.",
    "portolan:column": "pop_density",
    "portolan:breaks": [
      5,
      20,
      60,
      200,
      600,
      2000
    ]
  },
  "sources": {
