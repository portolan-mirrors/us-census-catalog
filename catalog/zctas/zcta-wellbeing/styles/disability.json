{
  "version": 8,
  "name": "People with a disability",
  "metadata": {
    "description": "Share of the civilian non-institutionalized population reporting a disability, pale pink to deep magenta. Measured over all 33,037 ZIP Code Tabulation Areas with a published value: 6 classes with breaks at 10%/13%/16%/20%/26%, which fall at the 21st/40th/59th/78th/91st percentile of the national distribution. 21.91% have a coefficient of variation above 0.3 and render faded \u2014 the estimate is real but its margin of error swamps it.",
    "portolan:column": "pct_with_disability",
    "portolan:breaks": [
      10,
      13,
      16,
      20,
      26
    ]
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../zcta-wellbeing.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fill",
      "type": "fill",
      "source": "data",
      "source-layer": "zcta-wellbeing",
      "filter": [
        "has",
        "pct_with_disability"
      ],
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "pct_with_disability"
          ],
          "#feebe2",
          10,
          "#fcc5c0",
          13,
          "#fa9fb5",
          16,
          "#f768a1",
          20,
          "#dd3497",
          26,
          "#7a0177"
        ],
        "fill-opacity": [
          "case",
          [
            ">",
            [
              "coalesce",
              [
                "get",
                "pct_with_disability_cv"
              ],
              0
            ],
            0.3
          ],
          0.35,
          0.8
        ]
      }
    },
    {
      "id": "outline",
      "type": "line",
      "source": "data",
