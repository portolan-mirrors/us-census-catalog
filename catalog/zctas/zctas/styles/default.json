{
  "version": 8,
  "name": "Median household income",
  "metadata": {
    "description": "Median household income by ZIP Code Tabulation Area, viridis dark purple (low) to yellow (high). Measured over all 30,547 ZIP Code Tabulation Areas with a published value: 7 classes with breaks at $45k/$60k/$72k/$87k/$120k/$160k, which fall at the 9th/29th/50th/70th/90th/97th percentile of the national distribution. 9.6% have no published value and draw in neutral gray rather than as a low value. 9.97% have a coefficient of variation above 0.3 and render faded \u2014 the estimate is real but its margin of error swamps it.",
    "portolan:column": "median_hh_income",
    "portolan:breaks": [
      45000,
      60000,
      72000,
      87000,
      120000,
      160000
    ]
  },
